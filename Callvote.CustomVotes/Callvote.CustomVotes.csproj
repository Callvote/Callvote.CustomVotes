<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Title>Callvote.CustomVotes</Title>
		<Description>Custom Votes Module for SCP:SL's Callvote.</Description>
		<Version>1.0.0</Version>
		<Configurations>Debug;Release;EXILED</Configurations>
		<Platforms>x64</Platforms>
	</PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' != 'Release'">
        <Reference Include="Callvote" HintPath="$(SL_REFERENCES)\Callvote-EXILED.dll" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <Reference Include="Callvote" HintPath="$(SL_REFERENCES)\Callvote-LabAPI.dll" />
    </ItemGroup>

</Project>
